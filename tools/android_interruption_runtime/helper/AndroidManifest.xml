<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.meowwatch.audio_focus_probe" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <application android:label="MeowWatch audio focus probe" android:allowBackup="false"
        android:testOnly="true" android:debuggable="true" android:hasCode="true">
        <!-- Only shell/system callers holding DUMP may operate this test helper. -->
        <service android:name=".FocusService" android:exported="true"
            android:permission="android.permission.DUMP" android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
